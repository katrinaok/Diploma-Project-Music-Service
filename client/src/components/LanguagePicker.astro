---
const currentLang = Astro.currentLocale || 'uk';
const pathname = Astro.url.pathname;

function getPathFor(lang: string) {
  let pathWithoutLang = pathname;
  if (pathname.startsWith('/en/')) {
    pathWithoutLang = pathname.replace(/^\/en/, '');
  } else if (pathname === '/en') {
    pathWithoutLang = '/';
  }
  
  if (lang === 'uk') return pathWithoutLang || '/';
  if (pathWithoutLang === '/') return `/${lang}`;
  return `/${lang}${pathWithoutLang}`;
}
---

<div class="flex items-center bg-gray-100 rounded-lg p-1 text-xs font-bold">
  <a 
    href={getPathFor('uk')}
    class={`px-2 py-1 rounded-md transition-colors ${currentLang === 'uk' ? 'bg-white shadow-sm text-purple-700' : 'text-gray-500 hover:text-gray-700'}`}
  >
    UA
  </a>
  <a 
    href={getPathFor('en')}
    class={`px-2 py-1 rounded-md transition-colors ${currentLang === 'en' ? 'bg-white shadow-sm text-purple-700' : 'text-gray-500 hover:text-gray-700'}`}
  >
    EN
  </a>
</div>
