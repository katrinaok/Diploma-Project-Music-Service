---
import LanguageSwitcher from '../components/astro/LanguageSwitcher.astro';
import ThemeToggle from '../components/vue/ThemeToggle.vue';
import HeaderProfileDropdown from '../components/vue/HeaderProfileDropdown.vue';
import HeaderSearch from '../components/vue/HeaderSearch.vue';
import HeaderHomeButton from '../components/vue/HeaderHomeButton.vue';
import { useTranslations } from '../utils/i18n';

const lang = (Astro.params.lang || 'uk') as 'uk' | 'en';
const t = useTranslations(lang);
const basePath = `/${lang}`;

const pathname = Astro.url.pathname;
// Check if the current path is the home page
const isHome = pathname.endsWith('/home') || pathname === `/${lang}/home`;
---

<header class="bg-surface/90 dark:bg-surface/95 backdrop-blur-md border-b border-border-subtle shadow-xs sticky top-0 z-50 transition-colors relative">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Left: Brand Logo -->
    <div class="flex-1 flex items-center">
      <a href={`/${lang}/home`} class="flex items-center gap-2 group transition-transform active:scale-95 cursor-pointer" title={lang === 'uk' ? 'Хвиля - Головна' : 'Khvylia - Home'}>
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-tr from-purple-600 via-purple-500 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-purple-500/25 group-hover:shadow-purple-500/40 group-hover:scale-105 transition-all duration-300 flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 sm:w-5 sm:h-5">
            <rect x="2" y="9" width="2.5" height="6" rx="1.25" />
            <rect x="6.5" y="5" width="2.5" height="14" rx="1.25" />
            <rect x="11" y="2" width="2.5" height="20" rx="1.25" />
            <rect x="15.5" y="6" width="2.5" height="12" rx="1.25" />
            <rect x="20" y="10" width="2.5" height="4" rx="1.25" />
          </svg>
        </div>
        <span class="font-extrabold text-base sm:text-xl tracking-tight text-text-primary group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
          {lang === 'uk' ? 'Хвиля' : 'Khvylia'}
        </span>
      </a>
    </div>

    <!-- Center: Home Icon & Search -->
    <div class="flex-shrink-0 md:flex-1 flex justify-center items-center gap-1.5 sm:gap-2 max-w-2xl px-1 sm:px-4">
      <HeaderHomeButton client:load />
      <HeaderSearch client:load />
    </div>

    <!-- Right: Controls & Profile -->
    <div class="flex-1 flex items-center justify-end gap-1.5 sm:gap-4">
      <div class="hidden sm:flex items-center gap-2">
        <ThemeToggle client:load />
        <LanguageSwitcher />
      </div>
      
      <HeaderProfileDropdown client:load />
      
      <!-- Mobile Menu Button (Optional, for Theme/Lang toggle) -->
      <button id="mobile-menu-toggle" class="sm:hidden p-2 text-text-primary hover:bg-surface-hover rounded-lg transition-colors ml-1 cursor-pointer" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Menu -->
  <div id="mobile-menu" class="hidden sm:hidden absolute top-16 left-0 w-full bg-surface border-b border-border-subtle shadow-lg py-4 px-6 flex flex-col gap-4 z-50">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm font-medium text-text-secondary">{t('page.settings') || 'Налаштування'}</span>
      <div class="flex gap-2">
        <ThemeToggle client:load />
        <LanguageSwitcher />
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
