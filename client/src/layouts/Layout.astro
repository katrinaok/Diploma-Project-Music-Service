---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import GlobalPlayer from "../components/vue/GlobalPlayer.vue";
import ReplacementSwap from "astro-vtbot/components/ReplacementSwap.astro";

const { title = "MusicVerse" } = Astro.props;
const lang = Astro.params.lang || "uk";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // 0. Diagnostic: Catch and display errors
      window.addEventListener("error", (e) => {
        console.error("Global error caught:", e.message);
      });

      // 0.1 Automatic Seamless JWT Refresh Token Interceptor
      (() => {
        if (typeof window === "undefined") return;
        if (window.__authInterceptorInstalled) return;
        window.__authInterceptorInstalled = true;

        const originalFetch = window.fetch;
        let isRefreshing = false;
        let refreshSubscribers = [];

        const onTokenRefreshed = (newToken) => {
          refreshSubscribers.forEach((cb) => cb(newToken));
          refreshSubscribers = [];
        };

        const addRefreshSubscriber = (cb) => {
          refreshSubscribers.push(cb);
        };

        window.fetch = async function (...args) {
          let [resource, config] = args;
          config = config ? { ...config } : {};

          // Execute original request
          let response = await originalFetch(resource, config);

          // If 401 Unauthorized, and this is NOT a refresh or login request itself
          const urlStr = typeof resource === "string" ? resource : resource?.url || "";
          const isAuthEndpoint =
            urlStr.includes("/api/auth/login") ||
            urlStr.includes("/api/auth/refresh") ||
            urlStr.includes("/api/auth/register");

          if (response.status === 401 && !isAuthEndpoint) {
            const refreshToken = localStorage.getItem("refreshToken");
            if (!refreshToken) {
              return response;
            }

            if (!isRefreshing) {
              isRefreshing = true;
              try {
                const refreshRes = await originalFetch("http://localhost:5001/api/auth/refresh", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ refreshToken }),
                });

                if (refreshRes.ok) {
                  const data = await refreshRes.json();
                  if (data.token) {
                    localStorage.setItem("token", data.token);
                    if (data.refreshToken) {
                      localStorage.setItem("refreshToken", data.refreshToken);
                    }
                    onTokenRefreshed(data.token);
                    isRefreshing = false;

                    // Retry original request with new token
                    const headers = new Headers(config.headers || {});
                    headers.set("Authorization", `Bearer ${data.token}`);
                    config.headers = headers;
                    return originalFetch(resource, config);
                  }
                } else {
                  // Refresh token expired or revoked
                  isRefreshing = false;
                  localStorage.removeItem("token");
                  localStorage.removeItem("refreshToken");
                  window.dispatchEvent(new CustomEvent("session-expired"));
                  return response;
                }
              } catch (err) {
                isRefreshing = false;
                return response;
              }
            } else {
              // Wait for in-flight refresh to finish and retry
              return new Promise((resolve) => {
                addRefreshSubscriber((newToken) => {
                  const headers = new Headers(config.headers || {});
                  headers.set("Authorization", `Bearer ${newToken}`);
                  config.headers = headers;
                  resolve(originalFetch(resource, config));
                });
              });
            }
          }

          return response;
        };
      })();

      // 1. Theme handling
      const applyTheme = () => {
        const theme = (() => {
          if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
          ) {
            return localStorage.getItem("theme");
          }
          if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            return "dark";
          }
          return "light";
        })();

        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      applyTheme();

      document.addEventListener("astro:after-swap", applyTheme);
      document.addEventListener("astro:page-load", applyTheme);

      if (typeof window !== "undefined") {
        const observer = new MutationObserver(() => {
          const expected =
            localStorage.getItem("theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          const isDark = document.documentElement.classList.contains("dark");
          if (expected === "dark" && !isDark) {
            document.documentElement.classList.add("dark");
          } else if (expected === "light" && isDark) {
            document.documentElement.classList.remove("dark");
          }
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
      }
    </script>
    <ReplacementSwap />
  </head>
  <body
    class="bg-gray-50 dark:bg-[#0c0514] text-gray-900 dark:text-gray-100 antialiased h-screen w-screen overflow-hidden flex flex-col transition-colors duration-300"
  >
    <div
      id="scroll-wrapper"
      class="w-full h-full overflow-y-auto overflow-x-hidden relative"
    >
      <div class="w-screen flex flex-col min-h-full">
        <Header />

        <main class="flex-grow" data-vtbot-replace="main">
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <!-- SPA Persisted Spotify Player -->
    <GlobalPlayer client:load transition:persist="player" />
  </body>
</html>
