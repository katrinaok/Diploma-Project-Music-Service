---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import GlobalPlayer from "../components/vue/GlobalPlayer.vue";
import ReplacementSwap from 'astro-vtbot/components/ReplacementSwap.astro';

const { title = "MusicVerse" } = Astro.props;
const lang = Astro.params.lang || "uk";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // 0. Diagnostic: Catch and display errors
      window.addEventListener("error", (e) => {
        console.error("Global error caught:", e.message);
      });

      // 1. Theme handling
      const applyTheme = () => {
        const theme = (() => {
          if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
          ) {
            return localStorage.getItem("theme");
          }
          if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            return "dark";
          }
          return "light";
        })();

        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      applyTheme();

      document.addEventListener("astro:after-swap", applyTheme);
      document.addEventListener("astro:page-load", applyTheme);

      if (typeof window !== "undefined") {
        const observer = new MutationObserver(() => {
          const expected =
            localStorage.getItem("theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          const isDark = document.documentElement.classList.contains("dark");
          if (expected === "dark" && !isDark) {
            document.documentElement.classList.add("dark");
          } else if (expected === "light" && isDark) {
            document.documentElement.classList.remove("dark");
          }
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
      }
    </script>
    <ReplacementSwap />
  </head>
  <body
    class="bg-gray-50 dark:bg-[#0c0514] text-gray-900 dark:text-gray-100 antialiased min-h-screen flex flex-col transition-colors duration-300"
  >
    <Header />

    <main class="flex-grow" data-vtbot-replace="main">
      <slot />
    </main>

    <Footer />

    <!-- SPA Persisted Spotify Player -->
    <GlobalPlayer client:load transition:persist="player" />
  </body>
</html>
