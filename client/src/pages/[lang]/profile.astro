---
import Layout from "../../layouts/Layout.astro";
import Profile from "../../components/vue/Profile.vue";
import "../../styles/global.css";
import { useTranslations } from "../../utils/i18n";

const lang = (Astro.params.lang || 'uk') as 'uk' | 'en';
const t = useTranslations(lang);
const queryUserId = Astro.url.searchParams.get('id') ?? undefined;
const username = !queryUserId ? (Astro.cookies.get('username')?.value || '') : '';
---

<Layout title={`MusicVerse - ${t('page.profile')}`}>
    <Profile lang={lang} initialUsername={username} targetUserId={queryUserId} client:load />
</Layout>
