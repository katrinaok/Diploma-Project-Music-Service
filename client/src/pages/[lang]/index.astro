---
import Layout from "../../layouts/Layout.astro";
import Auth from "../../components/vue/Auth.vue";
import "../../styles/global.css";
import { useTranslations } from "../../utils/i18n";

const lang = (Astro.params.lang || 'uk') as 'uk' | 'en';
const t = useTranslations(lang);
---

<Layout title={`MusicVerse - ${t('page.login')}`}>
	<Auth lang={lang} client:load />
</Layout>
