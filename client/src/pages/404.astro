---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="404 - Сторінку не знайдено">
  <div class="min-h-screen bg-gray-50 dark:bg-transparent flex flex-col items-center justify-center px-4 transition-colors">
    <div class="text-center max-w-md w-full">
      <h1 class="text-8xl font-bold bg-gradient-to-r from-purple-600 to-indigo-600 dark:from-purple-400 dark:to-indigo-400 bg-clip-text text-transparent mb-4">404</h1>
      <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Сторінку не знайдено</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8">Вибачте, ми не змогли знайти сторінку, яку ви шукаєте. Можливо, її було переміщено, видалено, або ви ввели неправильну URL-адресу.</p>
      <a href="/" class="px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-xl transition-colors shadow-lg shadow-purple-500/30 inline-flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Повернутися на головну
      </a>
    </div>
  </div>
</Layout>
