# Підключення до бази даних PostgreSQL (через Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/khvylia_db?schema=public"
# Опціонально (пряме підключення для міграцій, наприклад для Supabase connection pooling)
DIRECT_URL="postgresql://user:password@localhost:5432/khvylia_db?schema=public"

# Порт сервера (за замовчуванням: 5001)
PORT=5001

# Секретний ключ для підпису JWT токенів
JWT_SECRET="your_strong_jwt_secret_key_here"

# Дані додатку зі Spotify Developer Dashboard
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

